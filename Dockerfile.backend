# ==============================================================================
# PayPulse Backend - Multi-Stage Container Definition
# ==============================================================================

# Stage 1: Build & Native C++ Compilation for better-sqlite3
FROM node:20-alpine AS builder
RUN apk add --no-cache python3 make g++
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Stage 2: Minimal Production Runtime
FROM node:20-alpine AS runner

# libstdc++ is strictly required by compiled better-sqlite3 native addon on Alpine musl
RUN apk add --no-cache libstdc++ dumb-init curl wget

WORKDIR /app
ENV NODE_ENV=production
ENV SQLITE_DB_PATH=/app/data/paypulse.db
ENV PORT=3001

# Pre-create data directory with non-root node:node permissions BEFORE volume mounting
RUN mkdir -p /app/data && chown -R node:node /app && chmod 775 /app/data

# Copy dependencies and application source
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/server ./server
COPY --from=builder --chown=node:node /app/src/shared ./src/shared
COPY --from=builder --chown=node:node /app/tsconfig*.json ./

USER node
EXPOSE 3001
VOLUME ["/app/data"]

# Native Node.js Healthcheck
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3001/api/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "./node_modules/tsx/dist/cli.mjs", "server/index.ts"]