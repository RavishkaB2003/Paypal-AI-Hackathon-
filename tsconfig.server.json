{
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["es2022"],
        "types": ["node"],
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "isolatedDeclarations": true

    },
    "include": ["server/**/*", "src/shared/**/*"]
}

